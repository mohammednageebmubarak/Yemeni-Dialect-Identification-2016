<Application x:Class="Dilacts_Identification.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#121B20"/><SolidColorBrush x:Key="AccentBrush" Color="#007A73"/>
  <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="15,8"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C9D3D8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="5"/><Setter Property="MinWidth" Value="100"/></Style>
 </Application.Resources>
</Application>
