<Window x:Class="Dilacts_Identification.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Automatic Dialect Identification" Width="860" Height="570" MinWidth="760" MinHeight="510" Background="{StaticResource PanelBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Closing="OnClosing">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#0D1519" Padding="18,12">
   <DockPanel><TextBlock Text="Automatic Dialect Identification" FontSize="19" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Home" Click="HomeClick"/><Button Content="Events" Click="HistoryClick"/></StackPanel></DockPanel>
  </Border>
  <TextBlock DockPanel.Dock="Bottom" Text="2016 research reconstruction • Experimental prediction, not proof of identity or origin" Margin="16,8" FontSize="11" Foreground="#92A3A9"/>
  <Grid Margin="22">
   <StackPanel x:Name="HomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="590">
    <TextBlock Text="Welcome" FontSize="27" TextAlignment="Center"/><TextBlock Text="Please start recording your voice — السلام عليكم" TextAlignment="Center" FontSize="17" Margin="0,5,0,18"/>
    <TextBlock Text="Available recorder device:" TextAlignment="Center"/><ComboBox x:Name="Devices" Margin="60,8"/>
    <TextBlock x:Name="Elapsed" Text="00:00:00" FontSize="56" Foreground="#00978D" TextAlignment="Center" Margin="0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="RecordButton" Content="●  Record" Click="RecordClick"/><Button x:Name="StopButton" Content="■  Stop" Click="StopClick" IsEnabled="False"/><Button Content="Open WAV…" Click="OpenClick" x:Name="OpenButton"/></StackPanel>
    <TextBlock x:Name="HomeStatus" TextAlignment="Center" Margin="0,14"/>
   </StackPanel>
   <StackPanel x:Name="PlayerPanel" Visibility="Collapsed" VerticalAlignment="Center" Width="660">
    <TextBlock Text="Player" FontSize="27" TextAlignment="Center"/><TextBlock x:Name="FileLabel" TextAlignment="Center" Margin="0,10"/>
    <Slider x:Name="Position" Minimum="0" Maximum="1" IsEnabled="False" Margin="20,10" ValueChanged="SeekChanged"/><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" TextAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="■ Stop" Click="PlaybackStop"/><Button Content="▶ Play / Pause" Click="PlayClick"/><TextBlock Text="Volume" VerticalAlignment="Center" Margin="15,0,5,0"/><Slider x:Name="Volume" Width="110" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeChanged"/></StackPanel>
    <Separator Margin="0,16"/><TextBlock Text="Click the button below to identify your voice" TextAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"><ComboBox x:Name="Method" SelectedIndex="0"><ComboBoxItem Content="MFCC"/><ComboBoxItem Content="DB4"/><ComboBoxItem Content="HAAR"/></ComboBox><Button x:Name="ModelButton" Content="Choose trained model…" Click="ModelClick"/><Button x:Name="IdentifyButton" Content="Identify" Click="IdentifyClick"/></StackPanel>
    <TextBlock x:Name="ModelLabel" Text="No model selected" TextAlignment="Center"/><ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,6" IsIndeterminate="False"/><TextBlock x:Name="PlayerStatus" TextAlignment="Center"/>
   </StackPanel>
   <StackPanel x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="620"><TextBlock Text="Identification Result" FontSize="27" TextAlignment="Center"/><TextBlock x:Name="ResultText" FontSize="40" Foreground="#00978D" TextAlignment="Center" Margin="0,30"/><TextBlock x:Name="ScoreText" TextAlignment="Center"/><TextBlock Text="Experimental classification among five known dialects; model score is not calibrated confidence." TextAlignment="Center" Margin="0,10"/><Button Content="Back to Home" Click="HomeClick" HorizontalAlignment="Center"/></StackPanel>
   <DockPanel x:Name="HistoryPanel" Visibility="Collapsed"><TextBlock DockPanel.Dock="Top" Text="Identification Events" FontSize="25" Margin="0,0,0,12"/><DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></DockPanel>
  </Grid>
 </DockPanel>
</Window>
